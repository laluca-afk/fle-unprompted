\
let tempsRestant;\
let intervalleTimer;\
\
function genererSujet() \{\
    clearInterval(intervalleTimer);\
    document.getElementById("timerAffichage").innerText = "";\
    \
    const niveauSelectionne = document.getElementById("niveauSelect").value;\
    \
    // Filtrer les sujets\
    const sujets Filtres = banqueDeSujets.filter(sujet => \{\
        return niveauSelectionne === "tous" || sujet.niveau === niveauSelectionne;\
    \});\
\
    // Tirage al\'e9atoire\
    const indexAleatoire = Math.floor(Math.random() * sujetsFiltres.length);\
    const sujetChoisi = sujetsFiltres[indexAleatoire].texte;\
    \
    // Affichage\
    document.getElementById("sujetAffichage").innerText = sujetChoisi;\
    \
    // Lancer un minuteur de 2 minutes pour s'entra\'eener\
    demarrerMinuteur(120); \
\}\
\
function demarrerMinuteur(secondes) \{\
    tempsRestant = secondes;\
    intervalleTimer = setInterval(() => \{\
        let minutes = Math.floor(tempsRestant / 60);\
        let secs = tempsRestant % 60;\
        secs = secs < 10 ? "0" + secs : secs;\
        \
        document.getElementById("timerAffichage").innerText = `
\f1 \uc0\u9201 \u65039 
\f0  Temps de parole restant : $\{minutes\}:$\{secs\}`;\
        \
        if (tempsRestant <= 0) \{\
            clearInterval(intervalleTimer);\
            document.getElementById("timerAffichage").innerText = "
\f1 \uc0\u8987 
\f0  Temps \'e9coul\'e9 ! Bravo !";\
        \}\
        tempsRestant--;\
    \}, 1000);\
\}\
